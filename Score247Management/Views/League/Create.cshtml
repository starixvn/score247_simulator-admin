@model Score247Management.ViewModels.League.CreateLeagueViewModel
@{
    ViewData["Title"] = "Create New League";
}
@{
    IEnumerable<SelectListItem> categories = Model.LeagueCategories
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.Name,
                                               Value = i.Id
                                           });
}

<h1>Create</h1>

<h4>League</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="League.Order" class="control-label"></label>
                <input asp-for="League.Order" class="form-control" />
                <span asp-validation-for="League.Order" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="League.Flag" class="control-label"></label>
                <input asp-for="League.Flag" class="form-control" />
                <span asp-validation-for="League.Flag" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="League.Name" class="control-label"></label>
                <input asp-for="League.Name" class="form-control" />
                <span asp-validation-for="League.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="League.LeagueCategory" class="control-label"></label>
                <select asp-for="League.LeagueCategory.Id" asp-items="categories" class="form-control"></select>
                <span asp-validation-for="League.LeagueCategory" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

