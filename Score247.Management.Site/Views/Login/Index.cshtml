<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Score247 Admin Site</title>
    <link href="~/styles/login.min.css" rel="stylesheet" />
</head>
<body>
    <div class="login-bg">
        <div class="login-container">
            <h1 class="title">Sign in</h1>
            <form asp-action="Login">
                <div class="group">
                    <span class="icon icon-username"></span>
                    <input type="text" name="username" placeholder="Username" class="text-control" />
                </div>
                <div class="group">
                    <span class="icon  icon-password"></span>
                    <input type="password" name="password" placeholder="Password" class="text-control" />
                </div>
                <button class="btn" type="submit">Submit</button>
            </form>
        </div>
    </div>
</body>
</html>