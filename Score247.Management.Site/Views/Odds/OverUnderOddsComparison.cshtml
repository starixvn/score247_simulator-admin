@model Score247Management.Core.Odds.Models.MatchOdds

<table class="table table-bordered tbl-odds">
    <thead>
        <tr>
            <th scope="col" rowspan="2">Bookmaker</th>
            <th scope="col" colspan="3">Live Odds</th>
            <th scope="col" colspan="3">Opening Odds</th>
        </tr>
        <tr>
            <th scope="col">Over</th>
            <th scope="col">O/U</th>
            <th scope="col">Under</th>
            <th scope="col">Over</th>
            <th scope="col">O/U</th>
            <th scope="col">Under</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BetTypeOddsList)
        {
            <tr>
                <td class="bookmakerName" onclick="getBookMakerOddsMovement(`@Model.MatchId`, `@item.Bookmaker.Id`)">
                    @Html.DisplayFor(modelItem => item.Bookmaker.Name)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.BetOptions.FirstOrDefault(x => x.Type == "over").LiveOdds)
                </td>

                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.BetOptions.FirstOrDefault(x => x.Type == "over").OptionValue)
                </td>

                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.BetOptions.FirstOrDefault(x => x.Type == "under").LiveOdds)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.BetOptions.FirstOrDefault(x => x.Type == "over").OpeningOdds)
                </td>

                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.BetOptions.FirstOrDefault(x => x.Type == "over").OpeningOptionValue)
                </td>

                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.BetOptions.FirstOrDefault(x => x.Type == "under").OpeningOdds)
                </td>
            </tr>
        }
    </tbody>
</table>