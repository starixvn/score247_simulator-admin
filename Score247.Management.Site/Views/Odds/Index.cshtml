@using  Score247Management.Core._Shared.Enumerations
@using Microsoft.Extensions.Configuration

@model Score247.Management.Site.ViewModels.Matches.OddsEventViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Odds Events";
    var eventViewData = new ViewDataDictionary(new Microsoft.AspNetCore.Mvc.ModelBinding.EmptyModelMetadataProvider(), new Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary()) { { "MatchId", Model.Match.Id } };
}

@section Styles {
    <link href="~/styles/match-details.css" rel="stylesheet" />
    <link href="~/styles/odds.css" rel="stylesheet" />
}

<div class="d-none">
    <input type="text" id="urlPrefix" name="urlPrefix" value="@Configuration["PagePathPrefix"]" />
</div>
<div>
    <partial name="SelectOddsTypeView" view-data="eventViewData" />
</div>
<div class="row">
    <div class="col-sm-4">
        <div class="match-area">
            <div class="match-info">
                <label class="match-info-name">@Html.DisplayNameFor(model => model.Match.Id):</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.Id)</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">League:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.League.Name) (@Html.DisplayFor(model => model.Match.League.Id))</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Teams:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.Teams.FirstOrDefault().Name) (@Html.DisplayFor(model => model.Match.Teams.FirstOrDefault().Id)) vs @Html.DisplayFor(model => model.Match.Teams.LastOrDefault().Name) (@Html.DisplayFor(model => model.Match.Teams.LastOrDefault().Id))</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Kick Off Time:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.DisplayDate)</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Event Status:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.MatchResult.EventStatus.DisplayName)</label>
            </div>
            @if (Model.Match.MatchResult.MatchStatus.DisplayName == MatchStatus.Penalties.DisplayName
|| Model.Match.MatchResult.MatchStatus.DisplayName == MatchStatus.EndedAfterPenalties.DisplayName)
            {
                <div class="match-info">
                    <label class="match-info-name">Penalty Score:</label>
                    <label class="match-value">
                        @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutHomeScore) - @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutAwayScore)
                    </label>
                </div>
            }
            <div class="match-info">
                <label class="match-info-name">Current Score:</label>
                <label class="match-value">
                    <span class="score">
                        @Html.DisplayFor(model => model.Match.LatestTimeline.HomeScore) - @Html.DisplayFor(model => model.Match.LatestTimeline.AwayScore)
                    </span>
                </label>
            </div>

            <div class="match-info">
                <label class="match-info-name">Match Status:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.MatchResult.MatchStatus.DisplayName) - @Html.DisplayFor(model => model.Match.MatchResult.MatchTime)'</label>
            </div>
        </div>
        <div class="OddsChangeArea">
            <div class="card">
                <div class="card-header" id="oddsEventHeading">
                    <div class="card-title" data-toggle="collapse" data-target="#oddsEvent" aria-expanded="true" aria-controls="oddsEvent">
                        Odds Change
                    </div>
                </div>
                <div aria-labelledby="oddsEventHeading" data-parent="#accordion" id="oddsEvent">
                    <div class="card-body create-form">
                        <form id="createOddsForm" onsubmit="sendOddsChange('@Model.Match.Id')">
                            <div class="column">
                                <div class="form-group">
                                    <label for="bookmaker" class="control-label">Bookmakder:</label>
                                    <select id="BookmakerId" name="BookmakerId" class="form-control">
                                        <option value="Macauslot">Macauslot</option>
                                        <option value="Bet365">Bet365</option>
                                        <option value="Easybet">Easybet</option>
                                        <option value="Pinnacle">Pinnacle</option>
                                        <option value="12Bet">12Bet</option>
                                        <option value="ibcbet">ibcbet</option>
                                    </select>
                                </div>
                                <div class="form-group oddsInput 1x2Odds">
                                    <label class="control-label">Home:</label>
                                    <input id="HomeOdds" name="HomeOdds" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput 1x2Odds">
                                    <label class="control-label">Away:</label>
                                    <input id="AwayOdds" name="AwayOdds" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput 1x2Odds">
                                    <label class="control-label">Draw:</label>
                                    <input id="DrawOdds" name="DrawOdds" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput OUOdds d-none">
                                    <label class="control-label">Over:</label>
                                    <input id="OverOdds" name="OverOdds" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput OUOdds d-none">
                                    <label class="control-label">Under:</label>
                                    <input id="UnderOdds" name="UnderOdds" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput OUOdds d-none">
                                    <label class="control-label">O/U:</label>
                                    <input id="TotalOUOdds" name="TotalOUOdds" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput HDPOdds d-none">
                                    <label class="control-label">Home:</label>
                                    <input id="HomeHDPOdds" name="HomeHDPOdds" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput HDPOdds d-none">
                                    <label class="control-label">HDP Value:</label>
                                    <input name="HDPHome" type="text" class="form-control" />
                                </div>
                                <div class="form-group oddsInput HDPOdds d-none">
                                    <label class="control-label">Away:</label>
                                    <input name="AwayHDPOdds" type="text" class="form-control" />
                                </div>
                                @*<div class="form-group oddsInput HDPOdds d-none">
                                    <label class="control-label">Away HDP:</label>
                                    <input name="HDPAway" type="text" class="form-control" />
                                </div>*@
                                <div class="form-group">
                                    <label class="control-label">Last Update:</label>
                                    <input name="LastUpdate" class="form-control customDateTimepicker" />
                                </div>
                            </div>
                            <div class="form-group">
                                <input type="submit" value="Create" class="btn-submit" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <h4 class="page-sub-title">Odds Comparison:</h4>
        <div id="oddsComparison">
            <partial name="1X2OddsComparison" model="Model.MatchOdds" />
        </div>

        <h4 class="page-sub-title">Odds Movement:</h4>
        <div id="oddsMovement">
            <partial name="1X2OddsMovement" model="Model.MatchOddsMovement" />
        </div>
    </div>
</div>