@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var matchTypeOptions = new List<SelectListItem>();
    matchTypeOptions.Add(new SelectListItem("Pre-Match Odds", "Pre-Match Odds"));
    matchTypeOptions.Add(new SelectListItem("Live-Match Odds", "Live-Match Odds"));

    var betTypeOptions = new List<SelectListItem>();
    betTypeOptions.Add(new SelectListItem("1x2", "1"));
    betTypeOptions.Add(new SelectListItem("Over/Under", "2"));
    betTypeOptions.Add(new SelectListItem("Asian Handicap", "3"));
}
<div class="filter">
    <form>
        <div class="row col-md-12">
            <div class="form-group">
                <label class="control-label">Choose Scenario:</label>
                <select class="form-control col-sm-12" asp-items="matchTypeOptions"></select>
            </div>
            <div class="form-group">
                <label class="control-label">BetType:</label>
                <select id="betType" onchange="onBetTypeChange('@ViewBag.MatchId', this)" name="betType" class="form-control col-sm-12" asp-items="betTypeOptions"></select>
            </div>
            <div class="form-group mt-auto">
                <input type="submit" value="Apply" class="btn-submit" />
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}