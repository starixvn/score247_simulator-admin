@using  Score247Management.Core._Shared.Enumerations

@model Score247.Management.Site.Models.Events.MatchPushEventDto
@{
    List<SelectListItem> eventTypes = new List<SelectListItem>();
    eventTypes.Add(new SelectListItem()
    {
        Text = "Match Start",
        Value = "match_started"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "1st Period Start",
        Value = "1st_period_start"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Break Start",
        Value = "break_start"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "2nd Period Start",
        Value = "2nd_period_start"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Match End Normal",
        Value = "match_end_normal"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Break Awaiting Extra Time",
        Value = "await_extra"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "1st Period Extra Time Start",
        Value = "1st_extra_start"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Break Extra Time",
        Value = "break_extra"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "2nd Period Extra Time Start",
        Value = "2nd_extra_start"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Match End After Extra",
        Value = "match_end_extra"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Break Awaiting Penalty",
        Value = "await_penalty"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Penalty Start",
        Value = "penalty_start"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Match End Penalty",
        Value = "match_end_pen"
    });

    List<SelectListItem> homeOrAway = new List<SelectListItem>();

    homeOrAway.Add(new SelectListItem()
    {
        Text = "None",
        Value = "null"
    });
    homeOrAway.Add(new SelectListItem()
    {
        Text = "Home",
        Value = "home"
    });
    homeOrAway.Add(new SelectListItem()
    {
        Text = "Away",
        Value = "away"
    });
}
<div class="card">
    <div class="card-header" id="matchTimeEventHeading">
        <div class="card-title collapsed" data-toggle="collapse" data-target="#matchTimeEvent" aria-expanded="true" aria-controls="matchTimeEvent">
            Match Time Event
        </div>
    </div>
    <div class="collapse" aria-labelledby="matchTimeEventHeading" data-parent="#accordion" id="matchTimeEvent">
        <div class="card-body create-form">
            <form asp-action="_CreateTimeEventPartial" asp-route-id="@ViewBag.MatchId">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="column">
                    <div class="form-group">
                        <label asp-for="payload.timeline.id" class="control-label">Event Id:</label>
                        <input name="payload.timeline.id" value="" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.type" class="control-label">Event Type</label>
                        <select asp-for="payload.timeline.type" asp-items="eventTypes" class="form-control" onchange="scoreTimeEventTypeChange(this)"></select>
                        <span asp-validation-for="payload.timeline.type" class="text-danger"></span>
                    </div>
                    <div id="aggregate_input" class="form-group row d-none">
                        <label for="aggregate_winner_id" class="control-label col-sm-2">Aggregate Winner:</label>
                        <select name="aggregate_winner_id" asp-items="homeOrAway" class="form-control  col-sm-2"></select>
                        <label for="aggregate_home_score" class="control-label col-sm-2">Aggregate Home Score:</label>
                        <input name="aggregate_home_score" type="number" value="0" class="form-control  col-sm-2" />
                        <label for="aggregate_away_score" class="control-label col-sm-2">Aggregate Away Score:</label>
                        <input name="aggregate_away_score" type="number" value="0" class="form-control  col-sm-2" />
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.time" class="control-label">Date</label>
                        <input value="@Model.payload.timeline.time" name="payload.timeline.time" class="form-control customDatepicker" />
                        <span asp-validation-for="payload.timeline.time" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.hour" class="control-label">Time</label>
                        <input asp-for="payload.timeline.hour" class="form-control" />
                        <span asp-validation-for="payload.timeline.hour" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn-submit" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}