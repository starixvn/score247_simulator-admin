<div class="row">
    <form asp-action="AutoEventNormalMatch" class="mx-1" asp-route-id="@ViewBag.MatchId">
        <div class="form-group">
            <input type="submit" value="Auto Events Normal Match" class="btn-default" />
        </div>
    </form>
    <form asp-action="AutoEventOvertimeMatch" class="mx-1" asp-route-id="@ViewBag.MatchId">
        <div class="form-group">
            <input type="submit" value="Auto Events Overtime Match" class="btn-default" />
        </div>
    </form>
    <form asp-action="AutoEventPenaltyMatch" class="mx-1" asp-route-id="@ViewBag.MatchId">
        <div class="form-group">
            <input type="submit" value="Auto Events Penalty Match" class="btn-default" />
        </div>
    </form>
</div>