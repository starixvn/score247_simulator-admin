@using  Score247Management.Core._Shared.Enumerations

@model Score247.Management.Site.Models.Events.MatchPushEventDto
<div class="card">
    <div class="card-header" id="matchPenaltyShootEventHeading">
        <div class="card-title collapsed" data-toggle="collapse" data-target="#matchPenaltyShootEvent" aria-expanded="true" aria-controls="matchPenaltyShootEvent">
            Penalty Shoot Event
        </div>
    </div>
    <div class="collapse" aria-labelledby="matchPenaltyShootEventHeading" data-parent="#accordion" id="matchPenaltyShootEvent">
        <div class="card-body create-form">
            <form asp-action="_CreatePenaltyShootEventPartial" asp-route-id="@ViewBag.MatchId">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="column">
                    <div class="form-group ">
                        <label asp-for="payload.timeline.time" class="control-label">Date</label>
                        <input name="payload.timeline.time" value="@Model.payload.timeline.time" class="form-control customDatepicker" />
                        <span asp-validation-for="payload.timeline.time" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.hour" class="control-label">Time</label>
                        <input asp-for="payload.timeline.hour" class="form-control" />
                        <span asp-validation-for="payload.timeline.hour" class="text-danger"></span>
                    </div>
                    <div class="form-group ">
                        <label asp-for="payload.timeline.team" class="control-label">Team</label>
                        <select asp-for="payload.timeline.team" class="form-control">
                            <option value="home">Home</option>
                            <option value="away">Away</option>
                        </select>
                        <span asp-validation-for="payload.timeline.team" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.goal_scorer.name" class="control-label">Player Shoot</label>
                        <input asp-for="payload.timeline.goal_scorer.name" class="form-control" />
                        <span asp-validation-for="payload.timeline.goal_scorer.name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.status" class="control-label">Scored/Missed</label>
                        <select asp-for="payload.timeline.status" class="form-control">
                            <option value="scored">Scored</option>
                            <option value="missed">Missed</option>
                        </select>
                        <span asp-validation-for="payload.timeline.status" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn-submit" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}