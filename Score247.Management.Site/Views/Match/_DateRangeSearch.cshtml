@model Score247.Management.Site.Models.DateSearchModel
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var leagueOptions = new List<SelectListItem>();
    leagueOptions.Add(new SelectListItem("All leagues", "all"));
    foreach (var league in Model.Leagues)
    {
        leagueOptions.Add(new SelectListItem(league.Name, league.Id));
    }
}
<div class="filter">
    <form asp-action="_DateRangeSearch">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row col-md-12">
            <div class="form-group">
                <label class="control-label">Sport:</label>
                <select class="form-control col-sm-12" id="exampleFormControlSelect1">
                    <option>Soccer</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="SelectedLeagueId" class="control-label">League:</label>
                <select class="form-control col-sm-12" id="leagueFilterId" asp-for="SelectedLeagueId" asp-items="leagueOptions"></select>
            </div>
            <div class="form-group">
                <label asp-for="SearchDate" class="control-label">Search Date:</label>
                <input value="@Model.SearchDate" name="SearchDate" class="form-control customDatepicker" />
                <span asp-validation-for="SearchDate" class="text-danger"></span>
            </div>
            <div class="form-group mx-2 d-none">
                <input name="Timezone" type="text" class="form-control timezone-hidden" />
            </div>
            <div class="form-group mt-auto">
                <input type="submit" value="Search" class="btn-submit" />
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}