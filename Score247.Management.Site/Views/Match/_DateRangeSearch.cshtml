@model Score247.Management.Site.Models.DateSearchModel
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var leagueOptions = new List<SelectListItem>();
    leagueOptions.Add(new SelectListItem("All leagues", "all"));
    foreach (var league in Model.Leagues)
    {
        leagueOptions.Add(new SelectListItem(league.Name, league.Id));
    }
}
<div class="mb-2">
    <form asp-action="_DateRangeSearch">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row col-md-12">
            <div class="form-group col-sm-3 mb-2">
                <select class="form-control col-sm-12" id="exampleFormControlSelect1">
                    <option>Soccer</option>
                </select>
            </div>
            <div class="form-group col-sm-4 mb-2">
                <select class="form-control col-sm-12" id="exampleFormControlSelect1" asp-for="SelectedLeagueId" asp-items="leagueOptions"></select>
            </div>
        </div>
        <div class="row col-md-12">
            <div class="form-group mx-2">
                <label asp-for="FromDate" class="control-label"></label>
                <input asp-for="FromDate" class="form-control mx-1" />
                <span asp-validation-for="FromDate" class="text-danger"></span>
            </div>
            <div class="form-group mx-2">
                <label asp-for="ToDate" class="control-label"></label>
                <input asp-for="ToDate" class="form-control  mx-1" />
                <span asp-validation-for="ToDate" class="text-danger"></span>
            </div>
            <div class="form-group mx-5 mt-auto">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}