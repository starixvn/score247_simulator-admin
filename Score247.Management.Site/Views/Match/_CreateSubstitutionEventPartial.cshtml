@using  Score247Management.Core._Shared.Enumerations

@model Score247.Management.Site.Models.Events.MatchPushEventDto
@{
    List<SelectListItem> eventTypes = new List<SelectListItem>();
    eventTypes.Add(new SelectListItem()
    {
        Text = "Shot Off Target",
        Value = "shot_off_target"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Shot On Target",
        Value = "shot_on_target"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Shot Save",
        Value = "shot_saved"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Offside",
        Value = "offside"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Penalty Awarded",
        Value = "penalty_awarded"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Corner Kick",
        Value = "corner_kick"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Free Kick",
        Value = "free_kick"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Goal kick",
        Value = "goal_kick"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Injury",
        Value = "injury"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Injury Return",
        Value = "injury_return"
    });
    eventTypes.Add(new SelectListItem()
    {
        Text = "Throw In",
        Value = "throw_in"
    });
    var periodTypes = new List<SelectListItem>();
    periodTypes.Add(new SelectListItem()
    {
        Text = "Main time",
        Value = "regular_period"
    });
    periodTypes.Add(new SelectListItem()
    {
        Text = "Injury Time",
        Value = "extra_time"
    });

    periodTypes.Add(new SelectListItem()
    {
        Text = "OverTime",
        Value = "overTime"
    });

    var matchTimePeriod = new List<SelectListItem>();
    for (var i = 1; i < 60; i++)
    {
        var timeValue = (i * 2).ToString();
        matchTimePeriod.Add(new SelectListItem()
        {
            Text = timeValue,
            Value = timeValue
        });
    }

    var matchTimeExtra = new List<SelectListItem>();
    for (var i = 1; i < 20; i++)
    {
        var timeValue = i.ToString();
        matchTimeExtra.Add(new SelectListItem()
        {
            Text = timeValue,
            Value = timeValue
        });
    }
}
<div class="card">
    <div class="card-header" id="substitutionEventHeading">
        <div class="card-title collapsed" data-toggle="collapse" data-target="#substitudeEvent" aria-expanded="true" aria-controls="substitudeEvent">
            Substitution Event
        </div>
    </div>
    <div class="collapse" aria-labelledby="substitutionEventHeading" data-parent="#accordion" id="substitudeEvent">
        <div class="card-body create-form">
            <form asp-action="CreateSubstitutionEventPartial" asp-route-id="@ViewBag.MatchId">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col">
                    <div class="form-group">
                        <label asp-for="payload.timeline.id" class="control-label">Event Id:</label>
                        <input name="payload.timeline.id" value="" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.period_type" class="control-label">Period Type</label>
                        <select id="eventType" asp-for="payload.timeline.period_type" asp-items="periodTypes" class="form-control" onchange="substitudePeriodTypeChange(this)"></select>
                        <span asp-validation-for="payload.timeline.period_type" class="text-danger"></span>
                    </div>
                    <div class="form-group ">
                        <label asp-for="payload.timeline.match_time" class="control-label">Match Time</label>
                        <select asp-for="payload.timeline.match_time" asp-items="matchTimePeriod" class="form-control"></select>
                        <span asp-validation-for="payload.timeline.match_time" class="text-danger"></span>
                    </div>
                    <div class="form-group d-none" id="substitudeExtratime">
                        <label asp-for="payload.timeline.stoppage_time" class="control-label">Match Injury Time</label>
                        <select asp-for="payload.timeline.stoppage_time" asp-items="matchTimeExtra" class="form-control"></select>
                        <span asp-validation-for="payload.timeline.stoppage_time" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.team" class="control-label">Team</label>
                        <select asp-for="payload.timeline.team" class="form-control">
                            <option value="home">Home</option>
                            <option value="away">Away</option>
                        </select>
                        <span asp-validation-for="payload.timeline.team" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.player_in.name" class="control-label">Player In:</label>
                        <input asp-for="payload.timeline.player_in.name" class="form-control" />
                        <span asp-validation-for="payload.timeline.player_in.name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.player_out.name" class="control-label">Player Out:</label>
                        <input asp-for="payload.timeline.player_out.name" class="form-control" />
                        <span asp-validation-for="payload.timeline.player_out.name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.time" class="control-label">Date</label>
                        <input value="@Model.payload.timeline.time" name="payload.timeline.time" class="form-control customDatepicker" />
                        <span asp-validation-for="payload.timeline.time" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.hour" class="control-label">Time</label>
                        <input asp-for="payload.timeline.hour" class="form-control" />
                        <span asp-validation-for="payload.timeline.hour" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="commentary1" class="control-label">Commentary 1</label>
                        <textarea id="commentary1" type="text" name="commentary" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="commentary2" class="control-label">Commentary 2</label>
                        <textarea id="commentary2" type="text" name="commentary" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="commentary3" class="control-label">Commentary 3</label>
                        <textarea id="commentary3" type="text" name="commentary" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn-submit" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}