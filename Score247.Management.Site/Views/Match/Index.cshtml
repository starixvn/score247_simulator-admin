@using Microsoft.Extensions.Configuration

@model Score247.Management.Site.ViewModels.Matches.MatchViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Index";
}

<div class="d-none">
    <input type="text" id="urlPrefix" name="urlPrefix" value="@Configuration["PagePathPrefix"]" />
</div>
<h1 class="page-title">Matches</h1>
<form class="list-quick-action">
    <button asp-action="Create" class="btn-default">New Match</button>
    <button type="button" class="btn-default" data-toggle="modal" data-target="#CreateDeleteMatchesByDate">Create/Delete Matches</button>
</form>
<form class="list-quick-action">
    <div class="icon-live-match mr-3"></div>
    @foreach (var item in Model.QuickDateSelectOptions)
    {
        <button type="button"
                onclick="location.href='@Url.Action("ShortcutSearchByDate", "Match", new {searchDate = item.Value, leagueId = Model.DateSearchModel.SelectedLeagueId})'"
                class="btn-datebar mr-3">
            <div>@item.DisplayName</div>
            <div>@item.DisplayDate</div>
        </button>
    }

    <div class="icon-calendar mr-3"></div>
</form>

<partial name="_DateRangeSearch" model="Model.DateSearchModel" />

<table id="mathes-table" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                Event Date
            </th>
            <th>
                @Html.DisplayName("Teams")
            </th>
            <th>
                League
            </th>
            <th>
                @Html.DisplayName("Event Status")
            </th>
            <th>
                @Html.DisplayName("Match Status")
            </th>
            <th>
                @Html.DisplayName("Result")
            </th>
            <th>
                Id
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Matches)
        {
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Teams.FirstOrDefault().Name) vs @Html.DisplayFor(modelItem => item.Teams.LastOrDefault().Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.League.Name) (@Html.DisplayFor(modelItem => item.League.Order))
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MatchResult.EventStatus.DisplayName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MatchResult.MatchStatus.DisplayName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayResult)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td style="font-size:x-small;">
                    @Html.ActionLink("Main Events", "Details", new { id = item.Id, timeSpan = Model.TimeOffsetString }) |
                    @Html.ActionLink("Odds", "Index", "Odds", new { id = item.Id, timeSpan = Model.TimeOffsetString }) |
                    @*@Html.ActionLink("Hightlights", "Index", new { })  |*@
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id, searchDate = Model.DateSearchModel.SearchDate, leagueId = Model.DateSearchModel.SelectedLeagueId })
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="form d-none">
    <div class="form-group">
        <input asp-for="TimeOffsetString" class="timezone-hidden" />
    </div>
</div>

<div id="CreateDeleteMatchesByDate" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Create/Delete Matches</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body filter">
                <div id="CreateMatchesSpinner" class="spinner-border text-success d-none" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
                <div class="row-create-match">
                    <label>League Limit: </label>
                    <input asp-for="CreateMatchLeagueLimit" id="LeagueInputLimit" class="form-control" value="100" onchange="UpdateLimitMatchInput(this.value)" />
                </div>
                <div class="row-create-match">
                    <label>Live</label>
                    <input id="LiveCount" class="form-control" name="LiveCount" type="text" value="0" />
                    <button id="btnCreateLiveMatches" class="btn-default">Create</button>
                    <button id="btnDeleteLiveMatches" class="btn-delete">Delete</button>
                </div>
                <div class="row-create-match">
                    <label>@Model.CreateDeleteMatchesModels[0].DisplayDate</label>
                    <input id="2ndPostEventDate" name="EventDate" value="@Model.CreateDeleteMatchesModels[0].EventDate" class="d-none" />
                    <input id="2ndPostCount" class="form-control" name="Count" type="text" value="@Model.CreateDeleteMatchesModels[0].Count" />
                    <button id="btnCreateMatch2ndPost" class="btn-default">Create</button>
                    <button id="btnDeleteMatch2ndPost" class="btn-delete">Delete</button>
                </div>
                <div class="row-create-match">
                    <input asp-for="CreateMatchLeagueLimit" value="100" class="d-none LeagueLimit" />
                    <label>@Model.CreateDeleteMatchesModels[1].DisplayDate</label>
                    <input id="1stPostEventDate" name="EventDate" value="@Model.CreateDeleteMatchesModels[1].EventDate" class="d-none" />
                    <input id="1stPostCount" class="form-control" name="Count" type="text" value="@Model.CreateDeleteMatchesModels[1].Count" />
                    <button id="btnCreateMatch1stPost" class="btn-default">Create</button>
                    <button id="btnDeleteMatch1stPost" class="btn-delete">Delete</button>
                </div>
                <div class="row-create-match">
                    <label class="">@Model.CreateDeleteMatchesModels[2].DisplayDate</label>
                    <input id="TodayEventDate" name="EventDate" value="@Model.CreateDeleteMatchesModels[2].EventDate" class="d-none" />
                    <input id="TodayCount" class="form-control" name="Count" type="text" value="@Model.CreateDeleteMatchesModels[2].Count" />
                    <button id="btnCreateMatchToday" class="btn-default">Create</button>
                    <button id="btnDeleteMatchToday" class="btn-delete">Delete</button>
                </div>
                <div class="row-create-match">
                    <label>@Model.CreateDeleteMatchesModels[3].DisplayDate</label>
                    <input id="1stPreEventDate" name="EventDate" value="@Model.CreateDeleteMatchesModels[3].EventDate" class="d-none" />
                    <input id="1stPreCount" class="form-control" name="Count" type="text" value="@Model.CreateDeleteMatchesModels[3].Count" />
                    <button id="btnCreateMatch1stPre" class="btn-default">Create</button>
                    <button id="btnDeleteMatch1stPre" class="btn-delete">Delete</button>
                </div>
                <div class="row-create-match">
                    <label>@Model.CreateDeleteMatchesModels[4].DisplayDate</label>
                    <input id="2ndPreEventDate" name="EventDate" value="@Model.CreateDeleteMatchesModels[4].EventDate" class="d-none" />
                    <input id="2ndPreCount" class="form-control" name="Count" type="text" value="@Model.CreateDeleteMatchesModels[4].Count" />
                    <button id="btnCreateMatch2ndPre" class="btn-default">Create</button>
                    <button id="btnDeleteMatch2ndPre" class="btn-delete">Delete</button>
                </div>
                <div class="row-special-day">
                    <input type="text" class="form-control" name="CustomEventDate" />
                    <input type="text" class="form-control" name="CustomCount" value="0" />
                    <button id="btnCreateMatchCustom" class="btn-default">Create</button>
                    <button id="btnDeleteMatchCustom" class="btn-delete">Delete</button>
                </div>

                <div class="row-create-match has-border-top">
                    <button id="btnCreateAllSiteMatches" class="btn-default create-all">Create All Sites</button>
                    <button class="btn-delete delete-all" data-toggle="modal" data-target="#confirmDeleteAll">Delete All Matches</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="confirmDeleteAll" class="modal fade" role="dialog" style="z-index: 1600;">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Confirm Delete All Matches</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <span>Do you really want to delete all matches?</span>
            </div>
            <div class="modal-footer">
                <button id="btnConfirmDeleteAllMatches" type="button" class="btn btn-danger" data-dismiss="modal">Yes, delete all</button>
            </div>
        </div>
    </div>
</div>