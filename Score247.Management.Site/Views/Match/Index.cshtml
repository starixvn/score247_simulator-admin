@model IEnumerable<Score247Management.Core.Matches.Models.Match>

@{
    ViewData["Title"] = "Index";
}

<h1>Matches</h1>
<form class="form-inline">
    <div class="form-group col-sm-3 mb-2">
        <select class="form-control col-sm-12" id="exampleFormControlSelect1">
            <option>Soccer</option>
        </select>
    </div>
    <div class="form-group col-sm-3 mb-2">
        <select class="form-control col-sm-12" id="exampleFormControlSelect1">
            <option>Select Leagues</option>
        </select>
    </div>
    <button asp-action="Create" class="btn btn-primary mb-2">New Match</button>
</form>
<table id="mathes-table" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventDate)
            </th>
            <th>
                @Html.DisplayName("Teams")
            </th>
            <th>
                @Html.DisplayName("Status")
            </th>
            <th>
                @Html.DisplayName("Result")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EventDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Teams.FirstOrDefault().Name) vs @Html.DisplayFor(modelItem => item.Teams.LastOrDefault().Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MatchResult.MatchStatus.DisplayName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LatestTimeline.HomeScore) - @Html.DisplayFor(modelItem => item.LatestTimeline.AwayScore)
                </td>
                <td style="font-size:x-small;">
                    @Html.ActionLink("Main Events", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Commentories", "Index", new { }) |
                    @Html.ActionLink("Hightlights", "Index", new { })
                </td>
            </tr>
        }
    </tbody>
</table>
