@model Score247.Management.Site.ViewModels.Match.MatchViewModel

@{
    ViewData["Title"] = "Index";
}

<h1 class="page-title">Matches</h1>
<form class="list-quick-action">
    <button asp-action="Create" class="btn-default">New Match</button>
    <button type="button" class="btn-default" data-toggle="modal" data-target="#cloneMatches">Create Matches</button>
    <button type="button" class="btn-default" data-toggle="modal" data-target="#cloneLiveMatches">Create Live Matches</button>
    <button type="button" class="btn-default" data-toggle="modal" data-target="#deleteMatchesByDate">Delete Matches</button>
    <button type="button" class="btn-default" data-toggle="modal" data-target="#CreateDeleteMatchesByDate">Create/Delete Matches</button>
</form>
<partial name="_DateRangeSearch" model="Model.DateSearchModel" />
<table id="mathes-table" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                Event Date
            </th>
            <th>
                @Html.DisplayName("Teams")
            </th>
            <th>
                League
            </th>
            <th>
                @Html.DisplayName("Status")
            </th>
            <th>
                @Html.DisplayName("Result")
            </th>
            <th>
                Id
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Matches)
        {
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Teams.FirstOrDefault().Name) vs @Html.DisplayFor(modelItem => item.Teams.LastOrDefault().Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.League.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MatchResult.MatchStatus.DisplayName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayResult)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td style="font-size:x-small;">
                    @Html.ActionLink("Main Events", "Details", new { id = item.Id, timeSpan = Model.TimeOffsetString }) |
                    @Html.ActionLink("Commentories", "Index", new { }) |
                    @Html.ActionLink("Hightlights", "Index", new { })
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="form d-none">
    <div class="form-group">
        <input asp-for="TimeOffsetString" class="timezone-hidden" />
    </div>
</div>
<div id="cloneMatches" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Matches</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body filter">
                <form asp-action="CloneMatches">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="column">
                        <div class="form-group">
                            <label asp-for="CloneMatchModel.EventDate" class="control-label">Date</label>
                            <input asp-for="CloneMatchModel.EventDate" class="form-control" />
                            <span asp-validation-for="CloneMatchModel.EventDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CloneMatchModel.Count" class="control-label">Count</label>
                            <input asp-for="CloneMatchModel.Count" class="form-control" />
                            <span asp-validation-for="CloneMatchModel.Count" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Create" class="btn-submit" />
                        <input type="button" data-dismiss="modal" value="Cancel" class="btn-cancel" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div id="cloneLiveMatches" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Live Matches</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body filter">
                <form asp-action="CloneLiveMatches">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="column">
                        <div class="form-group">
                            <label asp-for="CloneMatchModel.EventDate" class="control-label">Date</label>
                            <input asp-for="CloneMatchModel.EventDate" class="form-control" />
                            <span asp-validation-for="CloneMatchModel.EventDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CloneMatchModel.Count" class="control-label">Count</label>
                            <input asp-for="CloneMatchModel.Count" class="form-control" />
                            <span asp-validation-for="CloneMatchModel.Count" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Create" class="btn-submit" />
                        <input type="button" data-dismiss="modal" value="Cancel" class="btn-cancel" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div id="deleteMatchesByDate" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Matches</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body filter">
                <form asp-action="DeleteMatchesByDate">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="column">
                        <div class="form-group">
                            <label asp-for="DeleteMatchByDateCriteria.DeleteDate" class="control-label">Date</label>
                            <input asp-for="DeleteMatchByDateCriteria.DeleteDate" class="form-control" />
                            <span asp-validation-for="DeleteMatchByDateCriteria.DeleteDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Delete" class="btn-submit" />
                        <input type="button" data-dismiss="modal" value="Cancel" class="btn-cancel" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="deleteMatchesByDate" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Matches</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body filter">
                <form asp-action="DeleteMatchesByDate">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="column">
                        <div class="form-group">
                            <label asp-for="DeleteMatchByDateCriteria.DeleteDate" class="control-label">Date</label>
                            <input asp-for="DeleteMatchByDateCriteria.DeleteDate" class="form-control" />
                            <span asp-validation-for="DeleteMatchByDateCriteria.DeleteDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Delete" class="btn-submit" />
                        <input type="button" data-dismiss="modal" value="Cancel" class="btn-cancel" />
