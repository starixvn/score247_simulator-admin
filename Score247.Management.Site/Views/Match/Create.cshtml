@using  Score247Management.Core._Shared.Enumerations
@model Score247.Management.Site.ViewModels.Matches.CreateMatchViewModel
@{
    ViewData["Title"] = "Create";
}
@{
    IEnumerable<SelectListItem> tournaments = Model.Tournaments
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.Country + " " + i.Name,
                                               Value = i.Id
                                           });
    IEnumerable<SelectListItem> teams = Model.Teams
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.Name,
                                               Value = i.Id
                                           });
    List<SelectListItem> status = new List<SelectListItem>();
    status.Add(new SelectListItem()
    {
        Text = "Not Start",
        Value = "not_started"
    });
    status.Add(new SelectListItem()
    {
        Text = "Postponed",
        Value = "postponed"
    });
    status.Add(new SelectListItem()
    {
        Text = "Start Delayed",
        Value = "start_delayed"
    });
    status.Add(new SelectListItem()
    {
        Text = "Cancelled",
        Value = "cancelled"
    });
    status.Add(new SelectListItem()
    {
        Text = "Abadoned",
        Value = "abandoned"
    });

    status.Add(new SelectListItem()
    {
        Text = "Ended Normal",
        Value = "closed"
    });

    status.Add(new SelectListItem()
    {
        Text = "Ended After Extratime",
        Value = "aet"
    });

    status.Add(new SelectListItem()
    {
        Text = "Ended After Penalty",
        Value = "ap"
    });

    IEnumerable<SelectListItem> leagueRoundTypes = LeagueRoundType.GetAll<LeagueRoundType>().Select(i => new SelectListItem()
    {
        Text = i.DisplayName,
        Value = i.DisplayName
    });
}
<h1 class="page-title">New Match</h1>
<div class="row create-form">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-row">
                @*<div class="form-group col-md-12">
                        <input type="checkbox" class="form-check-input ml-2" name="Match.IsPostMatch" onchange="IsPreMatchChanged(this)" id="isPreMatch">
                        <label class="form-check-label ml-5" for="isPreMatch">Is Post Match</label>
                    </div>*@
                <div class="form-group col-md-6">
                    <label asp-for="Match.Tournament.Id" class="control-label">League</label>
                    <select asp-for="Match.Tournament.Id" asp-items="tournaments" class="form-control"></select>
                    <span asp-validation-for="Match.Tournament.Id" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Match.TournamentRound.Type.Value" class="control-label">League Round Type</label>
                    <select asp-for="Match.TournamentRound.Type.Value" asp-items="leagueRoundTypes" class="form-control"></select>
                    <span asp-validation-for="Match.TournamentRound.Type.Value" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Match.TournamentRound.Name" class="control-label">Tournament Round Name</label>
                    <input asp-for="Match.TournamentRound.Name" class="form-control" />
                    <span asp-validation-for="Match.TournamentRound.Name" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Match.TournamentRound.Number" class="control-label">Tournament Round Number</label>
                    <input asp-for="Match.TournamentRound.Number" class="form-control" />
                    <span asp-validation-for="Match.TournamentRound.Number" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Match.TournamentRound.Phase" class="control-label">Tournament Round Phase</label>
                    <input asp-for="Match.TournamentRound.Phase" class="form-control" />
                    <span asp-validation-for="Match.TournamentRound.Phase" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Match.TournamentRound.Group" class="control-label">Tournament Round Group</label>
                    <input asp-for="Match.TournamentRound.Group" class="form-control" />
                    <span asp-validation-for="Match.TournamentRound.Group" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="HomeTeam.Id" class="control-label">Home</label>
                    <select asp-for="HomeTeam.Id" asp-items="teams" class="form-control"></select>
                    <span asp-validation-for="HomeTeam.Id" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="AwayTeam.Id" class="control-label">Away</label>
                    <select asp-for="AwayTeam.Id" asp-items="teams" class="form-control"></select>
                    <span asp-validation-for="AwayTeam.Id" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="Match.Status" class="control-label"></label>
                    <select id="newMatchStatus" asp-for="Match.Status" asp-items="status" class="form-control"></select>
                    <span asp-validation-for="Match.Status" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Match.Venue.Name" class="control-label">Venue Name</label>
                    <input asp-for="Match.Venue.Name" class="form-control" />
                    <span asp-validation-for="Match.Venue.Name" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="Match.Scheduled" class="control-label">Date:</label>
                    <input value="@Model.Match.Scheduled" name="Match.Scheduled" class="form-control customDatepicker" />
                    <span asp-validation-for="Match.Scheduled" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Match.ScheduledTime" class="control-label">Time</label>
                    <input asp-for="Match.ScheduledTime" class="form-control" />
                    <span asp-validation-for="Match.ScheduledTime" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group mx-auto">
                <input type="submit" value="Save" class="btn-submit" />
                <button asp-action="Index" value="Cancel" class="btn-cancel">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}