<div class="card">
    <div class="card-header" id="h2hEventHeading">
        <div class="card-title collapsed" data-toggle="collapse" data-target="#h2h" aria-expanded="true" aria-controls="h2hEvent">
            Head To Head
        </div>
    </div>
    <div class="collapse" aria-labelledby="h2hEventHeading" data-parent="#accordion" id="h2h">
        <div class="card-body create-form">
            <form id="generateH2HData">
                <div class="input-group mb-3">
                    <select class="custom-select" name="h2hCase">
                        <option value="default" selected>Default</option>
                        <option value="Case1">Case 1</option>
                        <option value="Case2">Case 2</option>
                        <option value="Case3">Case 3</option>
                        <option value="Case4">Case 4</option>
                    </select>
                    <div class="input-group-append">
                        <button class="btn btn-primary" onclick="generateH2HData(`@ViewBag.MatchId`, event)">Generate H2H Data</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div id="h2hRequest" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Head To Head Request</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <pre id="H2HRequestContent"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnApplyH2H" type="button" class="btn btn-primary" data-dismiss="modal">Accept</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div id="h2hData" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Head To Head Data</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <pre id="h2hDataContent"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>