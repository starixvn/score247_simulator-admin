<div class="card">
    <div class="card-header" id="h2hEventHeading">
        <div class="card-title collapsed" data-toggle="collapse" data-target="#h2h" aria-expanded="true" aria-controls="h2hEvent">
            Head To Head
        </div>
    </div>
    <div class="collapse" aria-labelledby="h2hEventHeading" data-parent="#accordion" id="h2h">
        <div class="card-body create-form">
            <form id="generateH2HData">
                <div class="form-group">
                    <select class="form-control" name="h2hCase">
                        <option value="default" selected>Default</option>
                        <option value="Case1">Case 1</option>
                        <option value="Case2">Case 2</option>
                        <option value="Case3">Case 3</option>
                        <option value="Case4">Case 4</option>
                        <option value="Case5_Prematch_Status">Case 5 Prematch Status</option>
                        <option value="Case6_AB_Not_Count">Case 6 AB Not Count</option>
                        <option value="Case7_No_Lastmeeting">Case 7 No Lastmeeting</option>
                        <option value="Case8_No_Nextmeeting">Case 8 No Nextmeeting</option>
                    </select>
                </div>
                <div class="form-group">
                    <button class="btn-submit" onclick="generateH2HData(`@ViewBag.MatchId`, event)">Apply</button>
                </div>
            </form>
            <form id="generateTeamResultData">
                <label>Team Result</label>
                <div class="input-group mb-3">
                    <select class="custom-select" name="teamResultCase">
                        <option value="default" selected>Default</option>
                        <option value="team_result_case_1">Case 1</option>
                        <option value="team_result_case_2">Case 2</option>
                        <option value="team_result_abandoned">Case Abandoned</option>
                        <option value="team_result_case_4">Case 4</option>
                    </select>
                    <select class="custom-select" name="teamQualifier">
                        <option value="home" selected>Home</option>
                        <option value="away" selected>Away</option>
                    </select>
                    <div class="input-group-append">
                        <button class="btn btn-primary" onclick="generateTeamResultData(`@ViewBag.MatchId`, event)">Generate Team Result Data</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div id="h2hRequest" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Head To Head Request</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <textarea id="H2HRequestDataRaw" class="col-md-12" rows="20"></textarea>
                    <button class="btn-primary" onclick="FormatJsonRawData('H2HRequestDataRaw', 'H2HRequestContent')">Format H2H</button>
                    <pre id="H2HRequestContent"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnApplyH2H" type="button" class="btn-default" data-dismiss="modal">Accept</button>
                    <button type="button" class="btn-cancel" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div id="h2hData" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Head To Head Data</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <pre id="h2hDataContent"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>