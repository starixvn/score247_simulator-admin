@using  Score247Management.Core._Shared.Enumerations

@model Score247.Management.Site.ViewModels.Match.EventMatchViewModel

@{
    ViewData["Title"] = "Match Events";
}
@{
    var eventViewData = new ViewDataDictionary(new Microsoft.AspNetCore.Mvc.ModelBinding.EmptyModelMetadataProvider(), new Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary()) { { "MatchId", Model.Match.Id } };
}

<h1>Details</h1>

<div>
    <partial name="_AutoPushEventPartial" view-data="eventViewData" />
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Match.Id):
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Match.Id)
        </dd>
        <dt class="col-sm-2">
            Kick Off Time(UTC):
        </dt>
        <dd class="col-sm-2">
            @Html.DisplayFor(model => model.Match.DisplayDate)
        </dd>
        <dt class="col-sm-2">
            Teams:
        </dt>
        <dd class="col-sm-6">
            @Html.DisplayFor(model => model.Match.Teams.FirstOrDefault().Name) vs @Html.DisplayFor(model => model.Match.Teams.LastOrDefault().Name)
        </dd>
        <dt class="col-sm-2">Match Status:</dt>
        <dd class="col-sm-2">
            @Html.DisplayFor(model => model.Match.MatchResult.MatchStatus.DisplayName) - @Html.DisplayFor(model => model.Match.MatchResult.MatchTime)'
        </dd>
        <dt class="col-sm-2">Current Score:</dt>
        <dd class="col-sm-2">
            @Html.DisplayFor(model => model.Match.LatestTimeline.HomeScore) - @Html.DisplayFor(model => model.Match.LatestTimeline.AwayScore)
        </dd>
        @if (Model.Match.MatchResult.MatchStatus.DisplayName == MatchStatus.Penalties.DisplayName
  || Model.Match.MatchResult.MatchStatus.DisplayName == MatchStatus.EndedAfterPenalties.DisplayName)
        {
            <dt class="col-sm-2">Penalty Score:</dt>
            <dd class="col-sm-2">
                @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutHomeScore) - @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutAwayScore)
            </dd>
        }
    </dl>

    <hr />
    <div class="row">
        <div id="accordion" class="col-sm-4 mr-1">
            <partial name="_CreateTimeEventPartial" model="Model.MatchTimeEventDto" view-data="eventViewData" />
            <partial name="_CreateInjuryExtraTimeEventPartial" model="Model.MatchInjuryExtraEventDto" view-data="eventViewData" />
            <partial name="_CreateScoreEventPartial" model="Model.MatchGoalEventDto" view-data="eventViewData" />
            <partial name="_CreatePenaltyShootEventPartial" model="Model.MatchPenaltyEventDto" view-data="eventViewData" />
            <partial name="_CreatCardFaultEventPartial" model="Model.MatchCardEventDto" view-data="eventViewData" />
        </div>
        <div class="col-sm-7 search-table-outter">
            <partial name="_MatchTimelineEventPartial" model="Model.TimelineEvents" />
        </div>
    </div>
</div>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
