@using Microsoft.Extensions.Configuration
@using  Score247Management.Core._Shared.Enumerations

@inject IConfiguration Configuration
@model Score247.Management.Site.ViewModels.Matches.EventMatchViewModel

@{
    ViewData["Title"] = "Match Events";
}

@{
    var homeTeam = Model.LineUpsDto.lineups?.FirstOrDefault(x => x.team == "home");
    var awayTeam = Model.LineUpsDto.lineups?.FirstOrDefault(x => x.team == "away");
    var homePlayers = new List<LineupPlayer>();
    var awayPlayers = new List<LineupPlayer>();
    if (homeTeam != null)
    {
        homePlayers.AddRange(homeTeam.starting_lineup);
        homePlayers.AddRange(homeTeam.substitutes);
    }

    if (awayTeam != null)
    {
        awayPlayers.AddRange(awayTeam.starting_lineup);
        awayPlayers.AddRange(awayTeam.substitutes);
    }

    List<SelectListItem> homePlayersSelection = homePlayers?
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.name,
                                               Value = i.id
                                           }).ToList();

    List<SelectListItem> awayPlayersSelection = awayPlayers?
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.name,
                                               Value = i.id
                                           }).ToList();

    var eventViewData = new ViewDataDictionary(
        new Microsoft.AspNetCore.Mvc.ModelBinding.EmptyModelMetadataProvider(),
        new Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary()){ { "MatchId", Model.Match.Id },
            { "HomePlayers", homePlayersSelection },
            { "AwayPlayers", awayPlayersSelection }
    };
    IEnumerable<SelectListItem> scenariosSelected = Model.Scenarios
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.Name,
                                               Value = i.Id.ToString()
                                           });
}

@section Styles {
    <link href="~/styles/match-details.css" rel="stylesheet" />
}

<h1 class="page-title">Details</h1>

<div class="d-none">
    <input type="text" id="urlPrefix" name="urlPrefix" value="@Configuration["PagePathPrefix"]" />
</div>
<div class="row">
    <div class="col-sm-4">
        <form class="filter" asp-action="ApplyScenario" asp-route-matchId="@Model.Match.Id">
            <div class="d-flex">
                <div class="form-group">
                    <label class="control-label">Choose Scenario:</label>
                    <select name="scenarioId" asp-items="scenariosSelected" class="form-control"></select>
                </div>
                <div class="form-group mt-auto">
                    <input type="submit" value="Apply" class="btn-submit" />
                </div>
            </div>
        </form>
        <div class="match-area">
            <div class="match-info">
                <label class="match-info-name">@Html.DisplayNameFor(model => model.Match.Id):</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.Id)</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">League:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.League.Name) (@Html.DisplayFor(model => model.Match.League.Id))</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Season:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.LeagueSeason.Name) (@Html.DisplayFor(model => model.Match.LeagueSeason.Id))</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Teams:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.Teams.FirstOrDefault().Name) (@Html.DisplayFor(model => model.Match.Teams.FirstOrDefault().Id)) vs @Html.DisplayFor(model => model.Match.Teams.LastOrDefault().Name) (@Html.DisplayFor(model => model.Match.Teams.LastOrDefault().Id))</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Kick Off Time (@TempData["Timezone"]):</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.DisplayDate)</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Event Status:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.MatchResult.EventStatus.DisplayName)</label>
            </div>
            @if (Model.Match.MatchResult?.MatchStatus?.DisplayName == MatchStatus.Penalties.DisplayName
|| Model.Match.MatchResult?.MatchStatus?.DisplayName == MatchStatus.EndedAfterPenalties.DisplayName)
            {
                <div class="match-info">
                    <label class="match-info-name">Penalty Score:</label>
                    <label class="match-value">
                        @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutHomeScore) - @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutAwayScore)
                    </label>
                </div>
            }
            <div class="match-info">
                <label class="match-info-name">Current Score:</label>
                <label class="match-value">
                    <span class="score">
                        @Html.DisplayFor(model => model.Match.MatchResult.HomeScore) - @Html.DisplayFor(model => model.Match.MatchResult.AwayScore)
                    </span>
                </label>
            </div>

            <div class="match-info">
                <label class="match-info-name">Match Status:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.MatchResult.MatchStatus.DisplayName) - @Html.DisplayFor(model => model.Match.MatchResult.MatchTime)'</label>
            </div>
            <form>
                <div class="match-info coverage-container">
                    <label class="match-info-name">Coverage Info:</label>
                    @if (@Model.Match.Coverage != null && @Model.Match.Coverage.Live == true)
                    {
                        <div>
                            <label class="match-value">Enable</label>
                            (<a asp-controller="Match" asp-action="EnableDisableCoverage" asp-route-id="@Model.Match.Id">Disable Coverage</a>)
                        </div>

                    }
                    else
                    {
                        <div>
                            <label class="match-value">Disabled</label>
                            (<a asp-controller="Match" asp-action="EnableDisableCoverage" asp-route-id="@Model.Match.Id">Enable Coverage</a>)
                        </div>

                    }
                </div>
                @if (Model.Match.Coverage != null)
                {
                    <div>
                        <label class="match-info-name">Coverage Live: @Model.Match.Coverage.Live</label>
                    </div>
                    <div>
                        <label class="match-info-name">Coverage DetailEvent: @Model.Match.Coverage.DetailedEvents</label>
                    </div>
                    <div>
                        <label class="match-info-name">Coverage Commentary: @Model.Match.Coverage.Commentary</label>
                    </div>
                    <div>
                        <label class="match-info-name">Coverage Lineups: @Model.Match.Coverage.Lineups</label>
                    </div>
                }
            </form>
            <form class="view-json-data">
                <button id="btnGetH2H" onclick="getMatchH2H('@Model.Match.Id', event)" class="btn-view-data">H2H Data</button>
                <button id="btnGetLineups" onclick="getMatchLineups('@Model.Match.Id', event)" class="btn-view-data">LineUps Data</button>
            </form>
        </div>
        <div id="accordion">
            <partial name="_CreateTimeEventPartial" model="Model.MatchTimeEventDto" view-data="eventViewData" />
            <partial name="_CreateInjuryExtraTimeEventPartial" model="Model.MatchInjuryExtraEventDto" view-data="eventViewData" />
            <partial name="_CreateScoreEventPartial" model="Model.MatchGoalEventDto" view-data="eventViewData" />
            <partial name="_CreatePenaltyShootEventPartial" model="Model.MatchPenaltyEventDto" view-data="eventViewData" />
            <partial name="_CreatCardFaultEventPartial" model="Model.MatchCardEventDto" view-data="eventViewData" />
            <partial name="_CreateVAREventPartial" model="Model.MatchVAREventDto" view-data="eventViewData" />
            <partial name="_CreateSubstitutionEventPartial" model="Model.MatchSubstitutionEventDto" view-data="eventViewData" />
            <partial name="_CreateMinorEventPartial" model="Model.MatchMinorEventDto" view-data="eventViewData" />
            <partial name="_MatchStatisticPartial" model="Model.Statistic" view-data="eventViewData" />
            <partial name="_CreateLineupsPartial" view-data="eventViewData" />
            <partial name="_CreateH2HPartial" view-data="eventViewData" />
            <partial name="_LeagueStandingPartial" view-data="eventViewData" />
        </div>
    </div>
    <div class="col-sm-8 timeline-events">
        <partial name="_MatchTimelineEventPartial" model="Model.TimelineEvents" view-data="eventViewData" />
    </div>
    <div id="eventRequest" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Event Request</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <textarea id="eventDataRaw" class="col-md-12" rows="20"></textarea>
                    <button id="formatEventData" class="btn-primary" onclick="FormatJsonRawData('eventDataRaw', 'eventRequestContent')">Format Event</button>
                    <pre id="eventRequestContent"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnSendNotApplyEvents" type="button" onclick="applyEvent(true)" class="btn-default" data-dismiss="modal">Send Missing Event</button>
                    <button id="btnApplyEvents" type="button" onclick="applyEvent(false)" class="btn-default" data-dismiss="modal">Apply Event</button>
                    <button type="button" class="btn-cancel" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/bundles/matches.min.js"></script>
}