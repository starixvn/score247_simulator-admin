@using Microsoft.Extensions.Configuration
@using  Score247Management.Core._Shared.Enumerations

@inject IConfiguration Configuration
@model Score247.Management.Site.ViewModels.Matches.EventMatchViewModel

@{
    ViewData["Title"] = "Match Events";
}
@{
    var eventViewData = new ViewDataDictionary(new Microsoft.AspNetCore.Mvc.ModelBinding.EmptyModelMetadataProvider(), new Microsoft.AspNetCore.Mvc.ModelBinding.ModelStateDictionary()) { { "MatchId", Model.Match.Id } };
    IEnumerable<SelectListItem> scenariosSelected = Model.Scenarios
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.Name,
                                               Value = i.Id.ToString()
                                           });
}

@section Styles {
    <link href="~/styles/match-details.css" rel="stylesheet" />
}

<h1 class="page-title">Details</h1>

<div class="d-none">
    <input type="text" id="urlPrefix" name="urlPrefix" value="@Configuration["PagePathPrefix"]" />
</div>
<div class="row">
    <div class="col-sm-4">
        <form class="filter" asp-action="ApplyScenario" asp-route-matchId="@Model.Match.Id">
            <div class="d-flex">
                <div class="form-group">
                    <label class="control-label">Choose Scenario:</label>
                    <select name="scenarioId" asp-items="scenariosSelected" class="form-control"></select>
                </div>
                <div class="form-group mt-auto">
                    <input type="submit" value="Apply" class="btn-submit" />
                </div>
            </div>
        </form>
        <div class="match-area">
            <div class="match-info">
                <label class="match-info-name">@Html.DisplayNameFor(model => model.Match.Id):</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.Id)</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">League:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.League.Name) (@Html.DisplayFor(model => model.Match.League.Id))</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Teams:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.Teams.FirstOrDefault().Name) (@Html.DisplayFor(model => model.Match.Teams.FirstOrDefault().Id)) vs @Html.DisplayFor(model => model.Match.Teams.LastOrDefault().Name) (@Html.DisplayFor(model => model.Match.Teams.LastOrDefault().Id))</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Kick Off Time (@TempData["Timezone"]):</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.DisplayDate)</label>
            </div>
            <div class="match-info">
                <label class="match-info-name">Event Status:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.MatchResult.EventStatus.DisplayName)</label>
            </div>
            @if (Model.Match.MatchResult?.MatchStatus?.DisplayName == MatchStatus.Penalties.DisplayName
|| Model.Match.MatchResult?.MatchStatus?.DisplayName == MatchStatus.EndedAfterPenalties.DisplayName)
            {
                <div class="match-info">
                    <label class="match-info-name">Penalty Score:</label>
                    <label class="match-value">
                        @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutHomeScore) - @Html.DisplayFor(model => model.Match.LatestTimeline.ShootoutAwayScore)
                    </label>
                </div>
            }
            <div class="match-info">
                <label class="match-info-name">Current Score:</label>
                <label class="match-value">
                    <span class="score">
                        @Html.DisplayFor(model => model.Match.LatestTimeline.HomeScore) - @Html.DisplayFor(model => model.Match.LatestTimeline.AwayScore)
                    </span>
                </label>
            </div>

            <div class="match-info">
                <label class="match-info-name">Match Status:</label>
                <label class="match-value">@Html.DisplayFor(model => model.Match.MatchResult.MatchStatus.DisplayName) - @Html.DisplayFor(model => model.Match.MatchResult.MatchTime)'</label>
            </div>
            <form>
                <div class="match-info coverage-container">
                    <label class="match-info-name">Coverage Info:</label>
                    @if (@Model.Match.Coverage != null)
                    {
                        <label class="match-value">@Model.Match.Coverage.Live</label>
                    }
                    else
                    {
                        <label class="match-value">false</label>
                    }
                    <button asp-controller="Match" asp-action="EnableDisableCoverage" asp-route-id="@Model.Match.Id" class="btn-default">Enable/Disable Coverage</button>
                </div>
            </form>
        </div>
        <div id="accordion">
            <partial name="_CreateTimeEventPartial" model="Model.MatchTimeEventDto" view-data="eventViewData" />
            <partial name="_CreateInjuryExtraTimeEventPartial" model="Model.MatchInjuryExtraEventDto" view-data="eventViewData" />
            <partial name="_CreateScoreEventPartial" model="Model.MatchGoalEventDto" view-data="eventViewData" />
            <partial name="_CreatePenaltyShootEventPartial" model="Model.MatchPenaltyEventDto" view-data="eventViewData" />
            <partial name="_CreatCardFaultEventPartial" model="Model.MatchCardEventDto" view-data="eventViewData" />
            <partial name="_CreateSubstitutionEventPartial" model="Model.MatchSubstitutionEventDto" view-data="eventViewData" />
            <partial name="_CreateMinorEventPartial" model="Model.MatchMinorEventDto" view-data="eventViewData" />
            <partial name="_MatchStatisticPartial" model="Model.Statistic" view-data="eventViewData" />
            <partial name="_CreateLineupsPartial" view-data="eventViewData" />
        </div>
    </div>
    <div class="col-sm-8 timeline-events">
        <partial name="_MatchTimelineEventPartial" model="Model.TimelineEvents" view-data="eventViewData" />
    </div>
</div>

@section Scripts
{
    <script src="~/bundles/matches.min.js"></script>
}