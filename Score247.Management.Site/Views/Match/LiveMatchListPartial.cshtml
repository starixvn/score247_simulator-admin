@model IEnumerable<Score247Management.Core.Matches.Models.MatchSummary>
<div>
    <div class="form-row">
        <div class="form-group col-md-1">
            <label>Post Count:</label>
            <input id="LivePostCount" class="form-control" name="LivePostCount" type="text" value="0" />
        </div>
        <div class="form-group col-md-1">
            <label>Live Count:</label>
            <input id="LiveCount" class="form-control" name="LiveCount" type="text" value="0" />
        </div>
        <div class="form-group col-md-1">
            <label>Pre Count:</label>
            <input id="LivePreCount" class="form-control" name="LivePreCount" type="text" value="0" />
        </div>
        <div class="form-group col-md-1">
            <label>League Limit:</label>
            <input id="LiveLeagueLimit" class="form-control" name="LiveLeagueLimit" type="text" value="100" />
        </div>
        <div class="form-group col-md-1 my-auto">
            <button id="btnCreateLiveMatches" class="btn-default">Create</button>
        </div>
        <div class="form-group col-md-1 my-auto">
            <button id="btnCloseAllLiveMatches" class="btn-default" onclick="ShowLoadingSpinner('#listMatches'); SendCloseAllLiveMatches();">Close All</button>
        </div>
    </div>
</div>
<table id="mathes-table" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                Event Date (@TempData["Timezone"])
            </th>
            <th>
                @Html.DisplayName("Teams")
            </th>
            <th>
                League
            </th>
            <th>
                @Html.DisplayName("Event Status")
            </th>
            <th>
                @Html.DisplayName("Match Status")
            </th>
            <th>
                @Html.DisplayName("Result")
            </th>
            <th>
                Id
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HomeTeamName) vs @Html.DisplayFor(modelItem => item.AwayTeamName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LeagueName) (@Html.DisplayFor(modelItem => item.LeagueName))
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EventStatus.DisplayName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MatchStatus.DisplayName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayResult)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td style="font-size:x-small;">
                    @Html.ActionLink("Main Events", "Details", new { id = item.Id }) |
                    <a href="#" onclick="CloseLiveMatch(`@item.Id`)">Closed</a> |
                    <a href="#" onclick="OpenLiveMatchDetail(`@item.Id`)">Edit</a>
                    @*@Html.ActionLink("Edit", "PreviewLiveMatch", "Live", new { matchId = item.Id })*@
                </td>
            </tr>
        }
    </tbody>
</table>