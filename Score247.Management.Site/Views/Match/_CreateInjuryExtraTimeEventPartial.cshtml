@using  Score247Management.Core._Shared.Enumerations

@model Score247.Management.Site.Models.Events.MatchPushEventDto
@{
    List<SelectListItem> periodTypes = new List<SelectListItem>();
    periodTypes.Add(new SelectListItem()
    {
        Text = "Main time",
        Value = "regular_period"
    });
    periodTypes.Add(new SelectListItem()
    {
        Text = "Extra Time",
        Value = "overtime"
    });
}
<div class="card">
    <div class="card-header" id="matchInjuryTimeExtraEventHeading">
        <h4 class="mb-0">
            <button class="btn btn-link" data-toggle="collapse" data-target="#matchInjuryTimeExtraEvent" aria-expanded="true" aria-controls="matchInjuryTimeExtraEvent">
                Injury Time Extra Event
            </button>
        </h4>
    </div>
    <div class="col-md-12 collapse" aria-labelledby="matchInjuryTimeExtraEventHeading" data-parent="#accordion" id="matchInjuryTimeExtraEvent">
        <div class="card-body">
            <form asp-action="CreateInjuryExtraTimeEventPartial" asp-route-id="@ViewBag.MatchId">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="column">
                    <div class="form-group">
                        <label asp-for="payload.timeline.period_type" class="control-label">Period Type</label>
                        <select id="eventType" asp-for="payload.timeline.period_type" asp-items="periodTypes" class="form-control"></select>
                        <span asp-validation-for="payload.timeline.period_type" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.time" class="control-label">Date</label>
                        <input asp-for="payload.timeline.time" class="form-control" />
                        <span asp-validation-for="payload.timeline.time" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.hour" class="control-label">Time</label>
                        <input asp-for="payload.timeline.hour" class="form-control" />
                        <span asp-validation-for="payload.timeline.hour" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.match_time" class="control-label">Match Time</label>
                        <input asp-for="payload.timeline.match_time" class="form-control" />
                        <span asp-validation-for="payload.timeline.match_time" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.match_clock" class="control-label">Match Clock</label>
                        <input asp-for="payload.timeline.match_clock" class="form-control" />
                        <span asp-validation-for="payload.timeline.match_clock" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.injury_time_announced" class="control-label">Time Extra</label>
                        <input asp-for="payload.timeline.injury_time_announced" class="form-control" />
                        <span asp-validation-for="payload.timeline.injury_time_announced" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
