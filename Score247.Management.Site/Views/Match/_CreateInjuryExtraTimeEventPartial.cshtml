@using  Score247Management.Core._Shared.Enumerations

@model Score247.Management.Site.Models.Events.MatchPushEventDto
@{
    List<SelectListItem> periodTypes = new List<SelectListItem>();
    periodTypes.Add(new SelectListItem()
    {
        Text = "1st Half",
        Value = "1st_half"
    });
    periodTypes.Add(new SelectListItem()
    {
        Text = "2nd Half",
        Value = "2nd_half"
    });
    periodTypes.Add(new SelectListItem()
    {
        Text = "1st Half Extra",
        Value = "1st_extra"
    });
    periodTypes.Add(new SelectListItem()
    {
        Text = "2nd Half Extra",
        Value = "2nd_extra"
    });

    List<SelectListItem> matchTimePeriod = new List<SelectListItem>();
    for (int i = 1; i < 25; i++)
    {
        var timeValue = (i * 5).ToString();
        matchTimePeriod.Add(new SelectListItem()
        {
            Text = timeValue,
            Value = timeValue
        });
    }
}
<div class="card">
    <div class="card-header" id="matchInjuryTimeExtraEventHeading">
        <div class="card-title collapsed" data-toggle="collapse" data-target="#matchInjuryTimeExtraEvent" aria-expanded="true" aria-controls="matchInjuryTimeExtraEvent">
            Injury Time Extra Event
        </div>
    </div>
    <div class="collapse" aria-labelledby="matchInjuryTimeExtraEventHeading" data-parent="#accordion" id="matchInjuryTimeExtraEvent">
        <div class="card-body create-form">
            <form id="EventInjuryExtraTimeForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="column">
                    <div class="form-group">
                        <label asp-for="payload.timeline.id" class="control-label">Event Id:</label>
                        <input name="payload.timeline.id" value="" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.sport_event_status.match_status" class="control-label">Period Type</label>
                        <select id="eventType" asp-for="payload.sport_event_status.match_status" asp-items="periodTypes" class="form-control"></select>
                        <span asp-validation-for="payload.sport_event_status.match_status" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.time" class="control-label">Date</label>
                        <input name="payload.timeline.time" value="@Model.payload.timeline.time" class="form-control customDatepicker" />
                        <span asp-validation-for="payload.timeline.time" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.hour" class="control-label">Time</label>
                        <input asp-for="payload.timeline.hour" class="form-control" />
                        <span asp-validation-for="payload.timeline.hour" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="payload.timeline.injury_time_announced" class="control-label">Time Extra</label>
                        <input asp-for="payload.timeline.injury_time_announced" class="form-control" />
                        <span asp-validation-for="payload.timeline.injury_time_announced" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="commentary1" class="control-label">Commentary 1</label>
                        <textarea id="commentary1" type="text" name="commentary1" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="commentary2" class="control-label">Commentary 2</label>
                        <textarea id="commentary2" type="text" name="commentary2" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="commentary3" class="control-label">Commentary 3</label>
                        <textarea id="commentary3" type="text" name="commentary3" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="form-group">
                    <button class="btn btn-primary" onclick="generateEventData(`@ViewBag.MatchId`, 'EventInjuryExtraTimeForm', 'InjuryExtraTimeEvent', event)">Process</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}