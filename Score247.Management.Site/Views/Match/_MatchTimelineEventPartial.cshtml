@model IEnumerable<Score247Management.Core.Matches.Models.TimelineEvent>
<h4 class="page-title">Timelines Events</h4>
<form class="list-quick-action" asp-action="CreateScenario" asp-route-matchId="@ViewBag.MatchId">
    <div class="form-group mx-sm-3 my-auto">
        <label for="scenarioName" class="sr-only">Scenario name:</label>
        <input type="text" class="form-control" id="scenarioName" required placeholder="Scenario Name" name="scenarioName">
    </div>
    <input type="submit" value="Create Scenario" class="btn-default my-auto" />
</form>
<table id="TimelineTable" class="table col-sm-12 table-striped table-bordered">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.Time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                Type
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.LocalTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Type.DisplayName)
                </td>
                <td style="font-size:x-small;">
                    <a href="#" id="reservationButton" class="btn-default btn-lg" onclick="@($"OpenModalPopUp('{item.RequestLog}')");">Request</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div id="logRequest" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Request Log</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <pre class="reservationDay"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}