@model IEnumerable<Score247Management.Core.Matches.Models.TimelineEvent>
<h4>Timelines Events:</h4>
<hr />
<table id="example" class="table col-sm-12">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                Type
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.LocalTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Type.DisplayName)
                </td>
                <td style="font-size:x-small;">
                    <button id="reservationButton" class="btn-default btn-lg" onclick="@($"OpenModalPopUp('{item.Value}')");">Request</button>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="modal-body">
    <div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-xs-3">
                    <b>Day</b>
                </div>
                <div class="col-xs-9">
                    <span class="reservationDay" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
