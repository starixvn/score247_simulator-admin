@model IEnumerable<Score247Management.Core.Leagues.Models.League>

@{
    ViewData["Title"] = "Leagues";
}

<h1 class="page-title">Leagues</h1>
<div class="list-quick-action">
    <button asp-action="Create" class="btn-default">New League</button>
    <button asp-action="SyncLeague" class="btn-default">Sync League</button>
</div>

<form class="row filter">
    <div class="form-group col-sm-3">
        <label class="control-label">Sport:</label>
        <select class="form-control col-sm-12" id="exampleFormControlSelect1">
            <option>Soccer</option>
        </select>
    </div>
</form>
<table id="leagues-table" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order)
            </th>
            <th>
                LeagueCategory
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
        <tr>
            <td></td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Order)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LeagueCategory.Name)
            </td>
        </tr>
}
    </tbody>
</table>