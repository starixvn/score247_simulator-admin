@model IEnumerable<Score247Management.Core.Leagues.Models.League>

@{
    ViewData["Title"] = "Leagues";
}

<h1 class="page-title">Leagues</h1>
<div class="row">
    <form class="list-quick-action col-sm-2">
        <button asp-action="Create" class="btn-default">New League</button>
        <button asp-action="SyncLeagues" class="btn-default">Sync League</button>
    </form>
    @*<button class="list-quick-action btn-danger" data-toggle="modal" data-target="#confirmCloneAndSyncCountryFlag">Sync Flag League</button>*@
</div>
<form class="row filter">
    <div class="form-group col-sm-3">
        <label class="control-label">Sport:</label>
        <select class="form-control col-sm-12" id="exampleFormControlSelect1">
            <option>Soccer</option>
        </select>
    </div>
</form>
<table id="leagues-table" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                Id
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order)
            </th>
            <th>
                IsActive
            </th>
            <th>
                LeagueCategory
            </th>
            <th>
                CountryCode
            </th>
            <th>
                Flag
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Order)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Country)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CountryCode)
                </td>
                <td>
                    <img style="max-height: 25px;" src="@item.Flag" />
                </td>
            </tr>
        }
    </tbody>
</table>
<div id="confirmCloneAndSyncCountryFlag" class="modal fade" role="dialog" style="z-index: 1600;">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Confirm Delete All Matches</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <span>Do you really want to delete all country images and crawl new images? It wil take times</span>
            </div>
            <div class="modal-footer">
                <button asp-action="SyncFlagLeague" type="button" class="btn btn-danger" data-dismiss="modal">Yes</button>
            </div>
        </div>
    </div>
</div>