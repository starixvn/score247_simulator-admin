@model Score247.Management.Site.ViewModels.League.CreateLeagueViewModel
@{
    ViewData["Title"] = "Create New League";
}
@{
    IEnumerable<SelectListItem> categories = Model.LeagueCategories
                                           .Select(i => new SelectListItem()
                                           {
                                               Text = i.Name,
                                               Value = i.Id
                                           });
}

<h1 class="page-title">New League</h1>
<div class="row create-form">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="League.Name" class="control-label"></label>
                <input asp-for="League.Name" class="form-control" />
                <span asp-validation-for="League.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="League.Order" class="control-label"></label>
                <input asp-for="League.Order" class="form-control" />
                <span asp-validation-for="League.Order" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="League.LeagueCategory.Id" class="control-label">League Category</label>
                <select asp-for="League.LeagueCategory.Id" asp-items="categories" class="form-control"></select>
                <span asp-validation-for="League.LeagueCategory.Id" class="text-danger"></span>
            </div>
            <div class="form-group row mx-auto">
                <input type="submit" value="Save" class="btn-submit" />
                <button asp-action="Index" value="Cancel" class="btn-cancel">Cancel</button>
            </div>
        </form>
    </div>
</div>