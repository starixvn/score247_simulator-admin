<h4>SportTeam Image Crawler</h4>
<hr />
<div class="row">
    <h4>Get Teams From Leagues</h4>
    <div class="col-md-4">
        <form asp-action="GetTeams">
            <div class="form-group">
                <input type="submit" value="Get Teams" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div class="row">
    <h4>Get Teams Flags</h4>
    <div class="col-md-4">
        <form asp-action="GetFlags">
            <div class="form-group">
                <input type="submit" value="Get Teams Flags" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div class="row">
    <h4>Get SportRadar Teams Logo</h4>
    <div class="col-md-4">
        <form asp-action="GetSportRadarTeamsLogo">
            <div class="form-group">
                <input type="submit" value="Get SportRadar Teams Logo" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div class="row">
    <h4>CrawlSportRadarTeamsLogo</h4>
    <div class="col-md-4">
        <form asp-action="CrawlSportRadarTeamsLogo">
            <div class="form-group">
                <input type="submit" value="Crawl SportRadarTeams Logo" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>