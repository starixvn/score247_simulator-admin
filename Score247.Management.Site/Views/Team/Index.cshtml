@model IEnumerable<Score247Management.Core.Teams.Models.Team>

@{
    ViewData["Title"] = "Index";
}

<h1 class="page-title">Teams</h1>
<div class="list-quick-action">
    <button asp-action="Create" class="btn-default">New Team</button>
</div>


<form class="row filter">
    <div class="form-group col-sm-3 mb-2">
        <label class="control-label">Sport:</label>
        <select class="form-control col-sm-12" id="exampleFormControlSelect1">
            <option>Soccer</option>
        </select>
    </div>

</form>
<table id="teams-table" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Abbreviation)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CountryCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Abbreviation)
                </td>
            </tr>
        }
    </tbody>
</table>